# =============================================================================
# QUANTUM BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
#
# Copy this file to `.env`, then replace placeholder credentials with your own.
#
# Bool parsing in backend:
# `1`, `true`, `yes`, `on` => true
# anything else => false
#
# =============================================================================
# SETUP GUIDE - Get Your API Keys Here:
# =============================================================================
#
# 1. COINBASE DEVELOPER PLATFORM (CDP) - For blockchain/wallet operations
#    - Visit: https://portal.cdp.coinbase.com
#    - Create a new project or select existing
#    - Navigate to "API Keys" section
#    - Click "New API Key" and download the JSON file
#    - Copy the key id to CDP_API_KEY_ID and the private key to CDP_API_KEY_SECRET
#    - Keep Ed25519. Enable Non-custodial: Export and Non-custodial: Manage
#    - Generate CDP_WALLET_SECRET once at Wallets → Non-custodial → Security
#    - Important: Keep the JSON file secure - it cannot be recovered if lost
#
# 2. TESTNET WALLET SETUP - For Base Sepolia development
#    - After setting CDP keys, run the backend once to auto-create a wallet
#    - The platform wallet address will be displayed in logs
#    - Test ETH and USDC are requested from the CDP Base Sepolia faucet when a wallet is created
#
# 3. RESEND EMAIL SERVICE - For transaction notifications
#    - Visit: https://resend.com/signup
#    - Create account and verify email
#    - Navigate to "API Keys" in dashboard
#    - Create new API key (starts with "re_")
#    - Free tier: 100 emails/day, 3,000/month
#
# 4. AWS BEDROCK - For Claude AI access
#    - Visit: https://console.aws.amazon.com/iam/
#    - Create IAM user with programmatic access
#    - Attach policy: AmazonBedrockFullAccess
#    - Save Access Key ID and Secret Access Key
#    - Enable Bedrock models in: https://console.aws.amazon.com/bedrock/
#    - Request access to Claude models if needed (usually instant)
#
# 5. WEB3.STORAGE - For IPFS/decentralized file storage
#    - Visit: https://web3.storage/login
#    - Sign in with email or GitHub
#    - Navigate to "Account" -> "Create API Token"
#    - Copy the token (starts with "eyJ")
#    - Free tier: 5GB storage
#
# =============================================================================

# -----------------------------------------------------------------------------
# App and API
# -----------------------------------------------------------------------------

# Typical values: `development`, `staging`, `production`, `test`
QB2_ENVIRONMENT=development

# Human-readable service name surfaced in logs and health endpoints.
QB2_SERVICE_NAME=quantum-backend

# API bind host and port.
QB2_API_HOST=0.0.0.0
QB2_API_PORT=8081

# Standard Python log levels: `DEBUG`, `INFO`, `WARNING`, `ERROR`, `CRITICAL`
QB2_LOG_LEVEL=INFO

# `true` => structured JSON logs, `false` => simpler local logs
QB2_JSON_LOGS=true

# `false` disables auth for local development only.
QB2_AUTH_REQUIRED=false

# Enables the hidden internal circuit routes used by the Algorand x402 gateway.
# This must match X402_GATEWAY_SECRET in the frontend deployment.
QB2_X402_GATEWAY_SECRET=

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------

# Allowed values:
# `local` => use QB2_POSTGRES_LOCAL_DSN
# `neon`  => use QB2_POSTGRES_NEON_POOLED_DSN / QB2_POSTGRES_NEON_DIRECT_DSN
QB2_POSTGRES_TARGET=local

# Local DSN format:
# `postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME`
# Source: your local Postgres install / Docker / cloud proxy.
QB2_POSTGRES_LOCAL_DSN=postgresql+asyncpg://postgres:password@127.0.0.1:5432/qds

# Neon pooled DSN for application traffic.
# Source: Neon Dashboard -> Project -> Connection Details -> Pooled connection.
QB2_POSTGRES_NEON_POOLED_DSN=postgresql+asyncpg://user:password@your-neon-pooler-host/neondb?sslmode=require

# Neon direct DSN for migrations and admin tooling.
# Source: Neon Dashboard -> Project -> Connection Details -> Direct connection.
QB2_POSTGRES_NEON_DIRECT_DSN=

# Logical database label shown in readiness output.
QB2_POSTGRES_DATABASE=qds

QB2_POSTGRES_ECHO=false
QB2_POSTGRES_POOL_PRE_PING=true

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------

# Allowed values:
# `local`  => use QB2_MONGODB_LOCAL_URI
# `remote` => use QB2_MONGODB_REMOTE_URI
QB2_MONGODB_TARGET=local

# Local URI examples:
# `mongodb://127.0.0.1:27017`
# `mongodb://USER:PASSWORD@127.0.0.1:27017/?authSource=admin`
QB2_MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017

# Atlas URI usually starts with `mongodb+srv://`.
# Source: MongoDB Atlas -> Cluster -> Connect -> Drivers.
QB2_MONGODB_REMOTE_URI=

# Logical database name inside MongoDB / Atlas.
QB2_MONGODB_DATABASE=qds

QB2_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Payment ledger
# -----------------------------------------------------------------------------

# Seconds between reconciliation sweeps (see PAYMENT_LEDGER.md). 0 disables.
QB2_PAYMENT_RECONCILE_INTERVAL_SECONDS=300

# Enables the hidden route the frontend's Stripe webhook uses to record credit
# packs. Must match BILLING_INTERNAL_SECRET in the frontend (32+ characters).
# Generate with: openssl rand -hex 32
QB2_BILLING_INTERNAL_SECRET=

# Credits charged per circuit run (1 credit = 1 USDC). 0 keeps runs free.
# Charging needs AGENT_AUTH_BRIDGE_SECRET so runs carry the user's identity.
QB2_CIRCUIT_JOB_CREDIT_COST=0

# Pay-per-fragment worker payouts (#8), funded from each job's credit hold.
# Platform wallet (in the wallets collection) that sends USDC to workers.
# Leave empty to record what workers earn without sending anything.
QB2_WORKER_PAYOUT_WALLET=
# Pay a worker once they are owed this much USDC, or their oldest unpaid
# fragment is this old, whichever comes first.
QB2_WORKER_PAYOUT_THRESHOLD=1
QB2_WORKER_PAYOUT_MAX_AGE_SECONDS=86400
# How often to send and confirm payouts. 0 turns sending off.
QB2_WORKER_PAYOUT_INTERVAL_SECONDS=300
# Fragments below this observed fidelity (0-1) are not paid.
QB2_WORKER_PAYOUT_MIN_FIDELITY=0

# -----------------------------------------------------------------------------
# Local peer log
# -----------------------------------------------------------------------------

# Where append-only peer log files are stored on disk.
QB2_PEER_LOG_DIR=./quantum-backend/peer-logs

# Stable local folder name for the peer log.
QB2_PEER_ID=qb2-local-peer

QB2_PEER_LOG_FSYNC=true

# -----------------------------------------------------------------------------
# Libp2p
# -----------------------------------------------------------------------------

# Enable/disable the real py-libp2p runtime.
QB2_LIBP2P_ENABLED=true

# Stable seed label used to derive the peer identity keypair.
QB2_LIBP2P_PEER_ID=qb2-local-peer

# Comma-separated listen multiaddrs.
# Example:
# `/ip4/0.0.0.0/tcp/4011`
QB2_LIBP2P_LISTEN_MULTIADDRS=/ip4/0.0.0.0/tcp/4011

# Optional comma-separated dialable multiaddrs to advertise to other peers.
# Use this when the bind address is not the same address peers should dial.
# Example:
# `/ip4/127.0.0.1/tcp/4011`
QB2_LIBP2P_ADVERTISE_MULTIADDRS=

# Comma-separated bootstrap peer multiaddrs, usually ending with `/p2p/<peer_id>`.
# Example:
# `/ip4/127.0.0.1/tcp/4011/p2p/12D3KooW...`
QB2_LIBP2P_BOOTSTRAP_PEERS=

# Peers must share the same namespace to discover each other.
QB2_LIBP2P_RENDEZVOUS_NAMESPACE=quantum-backend

# Local sqlite peerstore path for py-libp2p.
# `make run-clean` removes this file before startup.
QB2_LIBP2P_PEERSTORE_PATH=./quantum-backend/libp2p/peerstore.sqlite3

# `true` enables actual socket listeners; set this when using the local
# distributed dev fabric below.
QB2_LIBP2P_ACTIVATE_LISTENERS=true

# Extra local worker peers started alongside the main bootstrap/coordinator
# peer. Set this to `4` for the recommended `1 + 4` local swarm.
QB2_LIBP2P_DEV_SERVICE_PEER_COUNT=4

# Base TCP port for the embedded worker peers when they are enabled.
QB2_LIBP2P_DEV_SERVICE_BASE_PORT=4021

# -----------------------------------------------------------------------------
# AI & Agent Configuration
# -----------------------------------------------------------------------------

# AWS Bedrock Configuration (for Claude API via AWS)
# Set to `true` to use AWS Bedrock, `false` to use direct Anthropic API
AWS_BEDROCK_ENABLED=true

# AWS Region for Bedrock service
AWS_REGION=us-east-1

# AWS credentials for Bedrock access
# Source: AWS IAM -> Your Security Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Claude model ID for Bedrock (or Anthropic API)
# Bedrock format: anthropic.claude-3-5-sonnet-20241022-v2:0
# Direct API format: claude-3-5-sonnet-20241022
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Direct Anthropic API (alternative to Bedrock, used when AWS_BEDROCK_ENABLED=false)
# Source: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# -----------------------------------------------------------------------------
# AgentKit / Coinbase Developer Platform (CDP)
# -----------------------------------------------------------------------------

# CDP API credentials for blockchain operations
# Source: https://portal.cdp.coinbase.com -> API Keys
# Download the JSON file and extract the following values:
CDP_API_KEY_ID=your_cdp_api_key_id_here
CDP_API_KEY_SECRET=your_cdp_api_key_secret_here

# Platform wallet configuration
# These values are auto-generated on first run when CDP keys are configured
# PLATFORM_WALLET_ADDRESS: The main wallet address (e.g., 0x1234...abcd)
# PLATFORM_WALLET_SEED: Encrypted seed phrase for wallet recovery
PLATFORM_WALLET_ADDRESS=0x...
PLATFORM_WALLET_SEED=encrypted_seed

# Wallet network: registry alias or canonical CAIP-2 id.
# Base Sepolia wallet operations are enabled; mainnets are rejected.
# Unset NETWORK to use the registry default. Empty values are invalid.
NETWORK=base-sepolia

# Optional registry override for both public metadata and wallet configuration.
# NETWORK, if set, must resolve to an enabled entry in this registry.
# QB2_CHAIN_REGISTRY_PATH=/absolute/path/to/registry.toml
# Optional RPC overrides (https, or http to localhost for a local node). Unset uses
# the registry's keyless public endpoint. A provider URL with an API key belongs
# here, never in the TOML registry; it is not logged or returned by the API.
# GET /api/v1/chains never uses an RPC.
# QB2_BASE_SEPOLIA_RPC_URL=
# QB2_ETHEREUM_SEPOLIA_RPC_URL=
# QB2_ROBINHOOD_TESTNET_RPC_URL=
# Read-only Robinhood Chain mainnet price history (#18): eth_call only, no wallet.
# QB2_ROBINHOOD_MAINNET_RPC_URL=
# Starknet Sepolia RPC. Unset uses the public Blast endpoint in the registry.
# QB2_STARKNET_SEPOLIA_RPC_URL=
# Deployed spending-policy contract. Open, spend, and revoke return a call only when this is set.
# STARKNET_POLICY_CONTRACT=
# Ready wallet is the session owner. This key encrypts only the session private key.
# WALLET_ENCRYPTION_KEY=
# AVNU portal key for Sepolia gasfree sponsorship of account deploy and register_session.
# AVNU_PAYMASTER_API_KEY=

# -----------------------------------------------------------------------------
# ENS (Ethereum Name Service) — issue #22
# -----------------------------------------------------------------------------
# ENS lookups always hit Ethereum L1, even when NETWORK is an L2.
# Testnet payment networks → Sepolia; mainnet → Ethereum mainnet.
# Override the RPC if the public endpoint is rate-limited.
# ENS_NETWORK=sepolia
# ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Cache TTL in seconds (capped at 900). Re-resolve with fresh=true before sending funds.
# ENS_CACHE_TTL=300
# ENS_RESOLVE_TIMEOUT=8

# -----------------------------------------------------------------------------
# Email Notifications (Resend)
# -----------------------------------------------------------------------------

# Resend API key for sending transaction notifications
# Source: https://resend.com -> API Keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_...

# Email sender configuration (must be verified in Resend)
# For development, use onboarding@resend.dev (pre-verified)
# For production, verify your own domain
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=your-email@example.com

# -----------------------------------------------------------------------------
# IPFS / Decentralized Storage (Web3.Storage)
# -----------------------------------------------------------------------------

# Web3.Storage API key for IPFS uploads
# Source: https://web3.storage -> Account -> Create API Token
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
WEB3_STORAGE_API_KEY=eyJ...

# Server-side bridge; use the same random 32+ character secret in backend and frontend.
AGENT_AUTH_BRIDGE_SECRET=
# CDP wallet encryption/signing secret, separate from the API key above.
CDP_WALLET_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Allowed values: groq, openrouter, near -- (explicit selection; no automatic fallback)
AGENT_LLM_PROVIDER=groq
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# NEAR AI Cloud private inference (Confidential TEE models only; set per-key spend limit in NEAR dashboard)
NEARAI_API_KEY=
NEAR_MODEL=z-ai/glm-5.3-flash
TOJU_API_URL=https://toju-devcon-testnet.onrender.com
TOJU_PAYMENT_RECIPIENT=0xbB2Fc1cc295b53a75217319eA421256dABB3eacb
# Node 22 executable; never a browser-exposed setting.
TOJU_NODE_BINARY=node

# Optional platform Kubo RPC; use the same private token as the Kubo container.
# Default URL resolves inside Compose. Outside Docker use a protected connection;
# never publish the administration port publicly or expose this token to browsers.
KUBO_RPC_URL=http://kubo:5001
KUBO_RPC_SECRET=
# Finite timeout (0 < seconds <= 300); response budget in bytes (<= 64 MiB).
KUBO_RPC_TIMEOUT_SECONDS=30
KUBO_RPC_MAX_RESPONSE_BYTES=4194304

# Read-only IPFS gateway origin; no RPC credentials, paths, queries or fragments.
IPFS_GATEWAY_URL=http://kubo:8080
# Optional browser-facing gateway origin (for example https://ipfs.example.com).
# When set, published provenance bundles get an evidence link on the run page.
# Leave blank if the gateway has no public address; bundles are still published.
IPFS_PUBLIC_GATEWAY_URL=
# Total fetch deadline and maximum verified block size.
IPFS_GATEWAY_TIMEOUT_SECONDS=30
IPFS_GATEWAY_MAX_RESPONSE_BYTES=4194304
