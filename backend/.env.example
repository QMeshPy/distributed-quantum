# Local backend only. Copy to backend/.env; do not overwrite an existing file.
# Process environment overrides this file. The CLI and app factory use this same file.
# See ../documentations/guides/environment.md for optional features and key setup.
QB2_API_HOST=127.0.0.1
QB2_API_PORT=8081
QB2_ENVIRONMENT=development
# Local API exploration only; keep bound to loopback. Use true for shared deployments.
QB2_AUTH_REQUIRED=false
QB2_MONGODB_TARGET=local
QB2_MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017
QB2_MONGODB_DATABASE=quantum_backend_v2
# One coordinator + one embedded worker; no cloud credentials needed.
QB2_LIBP2P_LISTEN_MULTIADDRS=/ip4/127.0.0.1/tcp/4011
QB2_LIBP2P_DEV_SERVICE_PEER_COUNT=1
QB2_PEER_ID=local-dev-peer
QB2_PEER_LOG_DIR=./quantum-backend/peer-logs
QB2_LIBP2P_PEERSTORE_PATH=./quantum-backend/libp2p/peerstore.sqlite3
# Only needed for signed-in frontend requests: same random 32+ chars on both servers.
AGENT_AUTH_BRIDGE_SECRET=
