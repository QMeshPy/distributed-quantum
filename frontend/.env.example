# Copy to .env.local for local development. Never commit real values.

# Python backend that the Next.js API routes proxy to
NEXT_PUBLIC_BACKEND_URL=http://localhost:8081
# Set to true to skip the 1-hour trial gate locally
NEXT_PUBLIC_TRIAL_DISABLED=true

# Better Auth (sessions are stored in MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=quantum_platform
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sign-in codes are emailed through Resend
RESEND_API_KEY=
OTP_EMAIL_FROM=

# Server-side bridge; use the same random 32+ character secret in backend and frontend.
AGENT_AUTH_BRIDGE_SECRET=

# Algorand x402 resource server (disabled until the receiver is ready)
X402_ENABLED=false
X402_NETWORK=testnet
X402_AVM_ADDRESS=
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_QUANTUM_RUN_PRICE=$0.01

# Server-only credential. Must match QB2_X402_GATEWAY_SECRET in FastAPI.
# Generate with: openssl rand -hex 32
X402_GATEWAY_SECRET=

# Stripe billing (optional). Billing is enabled only when the three server
# variables below are set. Use test-mode keys (sk_test_...) only.
#   STRIPE_SECRET_KEY      Dashboard -> Developers -> API keys
#   STRIPE_PRICE_ID        Product catalog -> your recurring product -> Price ID (price_...)
#   STRIPE_WEBHOOK_SECRET  printed by `stripe listen` locally (whsec_...),
#                          or the endpoint's signing secret in the Dashboard
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Credit packs (optional, needs the Stripe variables above). Comma-separated
# one-time Price IDs and the credits each grants (1 credit = 1 USDC):
#   STRIPE_CREDIT_PACKS=price_abc:10,price_def:50
# BILLING_INTERNAL_SECRET must match QB2_BILLING_INTERNAL_SECRET in the backend.
STRIPE_CREDIT_PACKS=
BILLING_INTERNAL_SECRET=

# Stablecoin credit packs (optional, off by default). Set to "true" to also offer
# USD-priced packs in USDC through Stripe's crypto payment method. Request
# "Stablecoins and Cryptocurrency" under Dashboard -> Settings -> Payment methods
# first. Stripe settles in USD; we never hold wallet keys.
STRIPE_STABLECOIN_PAYMENTS=false

# EtherCalc preview (disabled until end-to-end validation is complete)
SPREADSHEETS_ENABLED=false
NEXT_PUBLIC_SPREADSHEETS_ENABLED=false
ETHERCALC_INTERNAL_URL=http://127.0.0.1:8000
ETHERCALC_KEY=
SPREADSHEET_GATEWAY_URL=http://127.0.0.1:8002
SPREADSHEET_APP_INTERNAL_URL=http://127.0.0.1:3000
KUBO_RPC_URL=
KUBO_RPC_SECRET=
