# Copy to frontend/.env.local. Never overwrite existing credentials.
# Optional integrations and key setup: ../documentations/guides/environment.md
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8081
NEXT_PUBLIC_TRIAL_DISABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=quantum_platform
BETTER_AUTH_URL=http://localhost:3000
# Generate separately with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Generate once and use the identical value in backend/.env.
AGENT_AUTH_BRIDGE_SECRET=
# Required for email-code sign-in; get an API key and verified sender from Resend.
RESEND_API_KEY=
OTP_EMAIL_FROM=
# Payments and cloud storage are optional; do not add keys until using those features.
X402_ENABLED=false
