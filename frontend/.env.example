# Existing backend connection
NEXT_PUBLIC_BACKEND_URL=http://localhost:8081

# Algorand x402 resource server (disabled until the receiver is ready)
X402_ENABLED=false
X402_NETWORK=testnet
X402_AVM_ADDRESS=
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
X402_QUANTUM_RUN_PRICE=$0.01

# Server-only credential. Must match QB2_X402_GATEWAY_SECRET in FastAPI.
# Generate with: openssl rand -hex 32
X402_GATEWAY_SECRET=
