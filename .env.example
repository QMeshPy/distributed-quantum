# Optional Docker deployment ONLY. Native development does not read this file.
# Copy to root .env for Compose; see documentations/guides/environment.md.
# Backend environment variables are passed through from this file to its container.
API_DOMAIN=api.example.com
QB2_ENVIRONMENT=production
QB2_AUTH_REQUIRED=true
QB2_MONGODB_TARGET=remote
QB2_MONGODB_REMOTE_URI=
QB2_MONGODB_DATABASE=quantum_backend_v2
AGENT_AUTH_BRIDGE_SECRET=
CORS_ORIGINS=https://app.example.com
PLATFORM_BASE_URL=https://api.example.com
# One embedded worker. Assign a unique stable peer ID to each coordinator.
QB2_PEER_ID=production-peer
QB2_LIBP2P_PEER_ID=production-peer
QB2_LIBP2P_DEV_SERVICE_PEER_COUNT=1
# Optional --profile storage (or monitoring); no Kubo credential needed otherwise.
# Generate: openssl rand -hex 32
KUBO_RPC_SECRET=
KUBO_GATEWAY_PORT=8080
KUBO_STORAGE_MAX=10GB
KUBO_GC_PERIOD=1h
