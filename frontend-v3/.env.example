# =============================================================================
# Frontend V3 Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------

# JWT secret key for signing tokens (REQUIRED)
# Generate a secure 256-bit secret with: openssl rand -hex 32
# This must be at least 64 hexadecimal characters (32 bytes)
JWT_SECRET=

# JWT token expiration time (default: 7d)
# Supported formats: 60, "2 days", "10h", "7d"
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Database (MongoDB)
# -----------------------------------------------------------------------------

# MongoDB connection URI (REQUIRED)
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# For local development: mongodb://localhost:27017
MONGODB_URI=

# MongoDB database name (REQUIRED)
MONGODB_DATABASE=quantum_frontend

# -----------------------------------------------------------------------------
# Free Tier Configuration
# -----------------------------------------------------------------------------

# Number of days for free trial (default: 14)
FREE_TRIAL_DAYS=14

# Maximum number of clusters allowed for free tier users (default: 3)
MAX_CLUSTERS_FREE=3

# Rate limit for free tier users in requests per minute (default: 100)
RATE_LIMIT_FREE_RPM=100

# -----------------------------------------------------------------------------
# Environment & Security
# -----------------------------------------------------------------------------

# Node environment: production | development | test
NODE_ENV=development

# Development mode auth bypass (NEVER true in production!)
# When true, bypasses authentication checks for local development
# WARNING: MUST be false or omitted in production environments
DEV_MODE_BYPASS_AUTH=true

# Enforce HTTPS-only connections (should be true in production)
HTTPS_ONLY=false

# -----------------------------------------------------------------------------
# Quantum Backend Configuration
# -----------------------------------------------------------------------------

# Default quantum cluster endpoint URL
# This is the fallback cluster when users haven't configured their own
# Format: http://localhost:8000 or https://quantum-cluster.example.com
QUANTUM_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Optional: Additional Configuration
# -----------------------------------------------------------------------------

# Next.js public URL (for redirects, emails, etc.)
# NEXTAUTH_URL=http://localhost:3000

# Port for development server (default: 3000)
# PORT=3000
