# Frontend-v3 runtime configuration.
# Keep real secrets only in this file. Do not commit them.
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# -----------------------------------------------------------------------------
# App and Service
# -----------------------------------------------------------------------------

# Allowed values: `development`, `staging`, `production`, `test`
NODE_ENV=development

# Human-readable service name shown in logs and health checks
SERVICE_NAME=quantum-frontend-v3

# Next.js bind configuration (usually handled by framework)
# PORT=3000
# NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------

# JWT secret key for signing session tokens (REQUIRED in production)
# Generate a secure 256-bit secret with: openssl rand -hex 32
# This MUST be at least 64 hexadecimal characters (32 bytes / 256 bits)
# Example: d4f8e2c1a3b5e7f9d4f8e2c1a3b5e7f9d4f8e2c1a3b5e7f9d4f8e2c1a3b5e7f9
JWT_SECRET=

# JWT token expiration time (default: 7d)
# Supported formats: 60, "2 days", "10h", "7d"
JWT_EXPIRES_IN=7d

# Session cookie configuration
# SESSION_COOKIE_NAME=session
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAME_SITE=lax
# SESSION_MAX_AGE=604800

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------

# Allowed values:
# `local`  => use MONGODB_LOCAL_URI
# `remote` => use MONGODB_REMOTE_URI (Atlas / MongoDB Cloud)
MONGODB_TARGET=remote

# Local URI format:
# `mongodb://HOST:PORT`
# or `mongodb://USER:PASSWORD@HOST:PORT/?authSource=admin`
# Get this from your local MongoDB install, Docker compose, or MongoDB Community.
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017

# Atlas/remote URI format usually starts with `mongodb+srv://`.
# Get this from MongoDB Atlas -> Cluster -> Connect -> Drivers.
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_REMOTE_URI=

# Logical database name inside the MongoDB cluster
MONGODB_DATABASE=quantum_frontend

# Vercel serverless optimization: fast cold-start timeout (5 seconds)
# Increase this if remote DNS/TLS handshakes are slow
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Connection pool settings (NOTE: Vercel serverless handles pooling at infra level)
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=0

# -----------------------------------------------------------------------------
# Email Service (Resend)
# -----------------------------------------------------------------------------

# Resend API key for sending OTP emails (REQUIRED for auth flow)
# Get your API key from: https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Email address to send OTP emails from
# For development: onboarding@resend.dev (Resend's test address)
# For production: noreply@yourdomain.com (requires verified domain in Resend)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email sender name (optional)
# RESEND_FROM_NAME=Quantum Dashboard

# OTP email configuration
# OTP_EXPIRY_MINUTES=10
# OTP_CODE_LENGTH=6

# -----------------------------------------------------------------------------
# Free Tier Configuration
# -----------------------------------------------------------------------------

# Number of days for free trial (default: 14)
# Users can access all features for this duration after signup
FREE_TRIAL_DAYS=14

# Maximum number of quantum clusters allowed for free tier users (default: 3)
# Users on free tier can configure up to this many cluster connections
MAX_CLUSTERS_FREE=3

# Rate limit for free tier users in requests per minute (default: 100)
# API proxy routes enforce this limit per user session
RATE_LIMIT_FREE_RPM=100

# Rate limit for paid tier users (optional, default: 1000)
# RATE_LIMIT_PRO_RPM=1000

# Usage tracking
# ENABLE_USAGE_LOGS=true
# USAGE_LOG_COLLECTION=usage_logs

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Enforce HTTPS-only connections (should be true in production)
# When true, redirects all HTTP requests to HTTPS
HTTPS_ONLY=false

# Development mode auth bypass (NEVER true in production!)
# When true, bypasses authentication checks for local development
# WARNING: MUST be false or removed entirely in production deployments
DEV_MODE_BYPASS_AUTH=true

# CORS allowed origins (comma-separated list)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Content Security Policy (CSP)
# CSP_ENABLED=true
# CSP_REPORT_URI=/api/csp-report

# SSRF prevention: block private IP ranges (enabled by default)
# BLOCK_PRIVATE_IPS=true

# -----------------------------------------------------------------------------
# Quantum Backend Configuration
# -----------------------------------------------------------------------------

# Default quantum cluster endpoint URL (fallback when user hasn't configured clusters)
# This is used as the default cluster connection for new users
# Format: http://localhost:8000 (local dev) or https://quantum-cluster.example.com (prod)
QUANTUM_BACKEND_URL=http://localhost:8000

# Default cluster protocol: `rest` or `jsonrpc` (default: rest)
# QUANTUM_BACKEND_PROTOCOL=rest

# Cluster health check interval in seconds (default: 30)
# CLUSTER_HEALTH_CHECK_INTERVAL=30

# Cluster request timeout in milliseconds (default: 30000)
# CLUSTER_REQUEST_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Optional: Analytics and Monitoring
# -----------------------------------------------------------------------------

# Vercel Analytics (Next.js built-in)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Error tracking (Sentry, Bugsnag, etc.)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Performance monitoring
# ENABLE_PERFORMANCE_MONITORING=true

# -----------------------------------------------------------------------------
# Optional: Feature Flags
# -----------------------------------------------------------------------------

# Enable experimental JSON-RPC protocol support
# ENABLE_JSONRPC=false

# Enable multi-cluster comparison view
# ENABLE_CLUSTER_COMPARISON=false

# Enable financial analysis features
# ENABLE_FINANCE_FEATURES=true

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------

# Enable React Query Devtools in development
# NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=true

# Enable verbose logging for debugging
# DEBUG=true

# Mock backend responses (for frontend-only development)
# ENABLE_MOCK_BACKEND=false
